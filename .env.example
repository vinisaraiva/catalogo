# ==============================
# Application
# ==============================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional default single-store slug for MVP routing/bootstrap.
DEFAULT_STORE_SLUG=

# ==============================
# Supabase
# ==============================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY.
# Never expose this variable to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# ==============================
# Google Cloud / Virtual Try-On
# ==============================

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Prefer environment/platform-managed credentials in production.
# For local development, point to a local credential file only if needed.
GOOGLE_APPLICATION_CREDENTIALS=

# Initial provider selector.
TRYON_AI_PROVIDER=google_vto

# ==============================
# Text AI
# ==============================

# Example values:
# openrouter
# opencode
# other
TEXT_AI_PROVIDER=

TEXT_AI_MODEL=
TEXT_AI_API_KEY=

# Optional explicit API base URL for providers that support it.
TEXT_AI_BASE_URL=

# ==============================
# AI limits
# ==============================

# Development fallback only.
# The authoritative per-store value should live in store settings.
DEFAULT_DAILY_AI_GENERATION_LIMIT=10

# ==============================
# Optional analytics
# ==============================

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ==============================
# Seed (development only)
# ==============================

# Used only by `npm run seed` to create/grant the dev store owner.
# Never set these in a production environment.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# ==============================
# Development
# ==============================

NODE_ENV=development
